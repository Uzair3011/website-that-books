# Copy to .env for local development. In production, set these in
# Vercel → Project → Settings → Environment Variables (never commit real values).

# ── Public contact details (baked into /assets/config.js at build time; not secret) ──
PUBLIC_CONTACT_EMAIL=hello@veltramedia.com
PUBLIC_CONTACT_PHONE=+447466539736
# International number, digits only (leading + is tolerated)
PUBLIC_WHATSAPP_NUMBER=447466539736
# Optional external scheduler (Calendly etc.) shown only when live booking is unavailable
PUBLIC_BOOKING_URL=

# ── Live booking: Google Calendar (server-only; mark as Sensitive in Vercel) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar that receives bookings; "primary" is the authorizing account's main calendar
GOOGLE_CALENDAR_ID=primary

# ── Booking rules (optional; defaults shown) ──
BOOKING_TIMEZONE=Europe/London
# Semicolon-separated rules, e.g. "mon-thu 09:00-17:00; fri 09:00-13:00"
BOOKING_HOURS=mon-fri 09:00-17:00
BOOKING_DURATION_MINUTES=20
BOOKING_SLOT_INTERVAL_MINUTES=30
BOOKING_BUFFER_MINUTES=10
BOOKING_MIN_NOTICE_HOURS=12
BOOKING_HORIZON_DAYS=21
# Set to false to skip adding a Google Meet link
BOOKING_GOOGLE_MEET=true

# ── Booking notification emails: SMTP (server-only; mark as Sensitive in Vercel) ──
# The client's confirmation and your internal notification are both sent here, instead of
# relying on Google Calendar's own guest-invite email (which always comes from the connected
# personal Google account). Zoho Mail: smtp.zoho.com (or smtp.zoho.eu for EU-hosted mailboxes),
# port 465 with SMTP_SECURE=true, using an app-specific password from Zoho Mail → Security.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@veltramedia.com
SMTP_PASS=
SMTP_FROM_NAME=Veltra Media
SMTP_FROM_EMAIL=hello@veltramedia.com
# Where the internal "new booking" notification is sent; defaults to SMTP_FROM_EMAIL if unset.
ADMIN_EMAIL=hello@veltramedia.com

# ── Lead intake: HTTPS CRM / automation webhook (server-only) ──
# The endpoint must accept JSON and return 2xx. Bookings are also forwarded here when set.
LEAD_WEBHOOK_URL=
# Optional shared secret sent as Authorization: Bearer <token>.
LEAD_WEBHOOK_TOKEN=

# Optional canonical origin, e.g. https://veltramedia.com
SITE_URL=
PORT=4174
