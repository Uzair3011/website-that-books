{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "veltramedia.com" }],
      "destination": "https://www.veltramedia.com/$1",
      "permanent": true
    },
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/website-that-books-fixed.html",
      "destination": "/",
      "permanent": true
    },
    { "source": "/privacy-policy", "destination": "/privacy", "permanent": true },
    {
      "source": "/ai-receptionist-for-med-spas",
      "destination": "/med-spa-growth-system",
      "permanent": true
    },
    {
      "source": "/med-spa-website-design",
      "destination": "/med-spa-growth-system",
      "permanent": true
    },
    {
      "source": "/med-spa-online-booking",
      "destination": "/med-spa-growth-system",
      "permanent": true
    },
    {
      "source": "/landing-pages",
      "destination": "/landing-page-design",
      "permanent": true
    },
    {
      "source": "/ai-receptionist",
      "destination": "/ai-automation-middlesbrough",
      "permanent": true
    },
    {
      "source": "/booking-follow-up-automation",
      "destination": "/crm-booking-automation",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
